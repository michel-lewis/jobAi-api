# Requêtes de l'API JobAI — extension VS Code "REST Client" (humao.rest-client)
# Clique sur "Send Request" au-dessus de chaque bloc.
# Ce fichier est versionné : il se partage et se relit comme du code.

@host = http://localhost:3000
@email = profiles-demo@example.com
@password = motdepasse123

### Inscription — attendu 201 (crée aussi le profil, dans la même transaction)
POST {{host}}/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "name": "Lewis"
}

### Connexion — attendu 200 + token
# @name login
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Sans jeton — attendu 401
GET {{host}}/profiles/me

### Jeton invalide — attendu 401
GET {{host}}/profiles/me
Authorization:

### Profil créé à l'inscription, version 1 — attendu 200 (regarde l'en-tête ETag)
# @name read
GET {{host}}/profiles/me
Authorization: Bearer {{login.response.body.token}}

### Document invalide (fullName manquant) — attendu 400
PUT {{host}}/profiles/me
Authorization: Bearer {{login.response.body.token}}
If-Match: "1"
Content-Type: application/json

{
  "experiences": [],
  "education": [],
  "skills": [],
  "languages": [],
  "certifications": [],
  "links": []
}

### PUT sans en-tête If-Match — attendu 400
PUT {{host}}/profiles/me
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "fullName": "Lewis Kouamkouam",
  "experiences": [],
  "education": [],
  "skills": [],
  "languages": [],
  "certifications": [],
  "links": []
}

### Remplacement avec un If-Match correct — attendu 200
# Colle la valeur de l'en-tête ETag de la requête "Profil créé à l'inscription"
# ci-dessus (normalement "1") dans If-Match.
PUT {{host}}/profiles/me
Authorization: Bearer {{login.response.body.token}}
If-Match: "1"
Content-Type: application/json

{
  "fullName": "Lewis Kouamkouam",
  "headline": "Développeuse backend · React / NestJS",
  "summary": "5 ans d'expérience en développement backend.",
  "email": null,
  "phone": null,
  "location": "Calgary, AB, Canada",
  "willingToRelocate": false,
  "workPreference": "hybrid",
  "workAuthorizationNote": null,
  "rawCvText": null,
  "experiences": [
    {
      "company": "Acme Corp",
      "title": "Développeuse backend",
      "employmentType": "full_time",
      "location": "Calgary, AB",
      "startDate": "2022-01-01",
      "endDate": null,
      "summary": null,
      "bullets": ["A livré une API de paiement", "A réduit le temps de build de 40%"]
    }
  ],
  "education": [
    {
      "school": "Université de Calgary",
      "degree": "Master informatique",
      "field": "Génie logiciel",
      "location": "Calgary, AB",
      "startDate": "2018-09-01",
      "endDate": "2020-06-01",
      "credentialEvaluation": null,
      "honours": null
    }
  ],
  "skills": [
    { "name": "TypeScript", "category": "language" },
    { "name": "NestJS", "category": "framework" }
  ],
  "languages": [
    { "name": "Français", "proficiency": "native" },
    { "name": "Anglais", "proficiency": "professional" }
  ],
  "certifications": [],
  "links": [
    { "kind": "github", "url": "https://github.com/lewis", "label": null }
  ]
}

### If-Match périmé (réutilise "1", déjà consommé par le remplacement ci-dessus) — attendu 409
PUT {{host}}/profiles/me
Authorization: Bearer {{login.response.body.token}}
If-Match: "1"
Content-Type: application/json

{
  "fullName": "Lewis Kouamkouam, encore modifié",
  "experiences": [],
  "education": [],
  "skills": [],
  "languages": [],
  "certifications": [],
  "links": []
}

### If-Match mal formé — attendu 400
PUT {{host}}/profiles/me
Authorization: Bearer {{login.response.body.token}}
If-Match: pas-un-nombre
Content-Type: application/json

{
  "fullName": "Lewis Kouamkouam",
  "experiences": [],
  "education": [],
  "skills": [],
  "languages": [],
  "certifications": [],
  "links": []
}
