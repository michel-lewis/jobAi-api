# Copier en .env et ajuster. Ne jamais committer le .env.
NODE_ENV=development
PORT=3000

# Doivent correspondre au docker-compose.yml
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=jobai
POSTGRES_SECRET=change-me
POSTGRES_DB_NAME=jobai
JWT_SECRET=change-me-with-openssl-rand-base64-48-min-32-chars
JWT_EXPIRATION=1h
# URL Neon en prod (Render). En local on utilise plutôt les POSTGRES_* ci-dessous,
# pointées vers le Postgres de docker-compose. sslmode=require est lu par pg
# directement depuis l'URL — ne pas ajouter d'option ssl séparée.
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# LLM (module llm). Valeurs = defauts du schema de src/config/env.validation.ts.
# Absente en environnement de test : LlmModule y branche un faux deterministe
# qui n'appelle jamais le reseau, donc jamais la cle.
ANTHROPIC_API_KEY=sk-ant-change-me
# claude-haiku-4-5 par defaut si non renseignee.
# LLM_MODEL=claude-haiku-4-5
LLM_TOTAL_BUDGET_MS=55000
LLM_MAX_ATTEMPTS=3
LLM_MAX_OUTPUT_TOKENS=1024
# 40 et non 20 : FORMAT_MAX_ATTEMPTS (2, ADR-14 decision 3a) double la
# consommation de quota par lettre. La limite promet 40 appels, soit 20 lettres
# par jour a l'utilisateur dans le cas courant.
LLM_DAILY_QUOTA_PER_USER=40
LLM_RETRY_BACKOFF_MS=500
# Doit rester >= FORMAT_MAX_ATTEMPTS * LLM_TOTAL_BUDGET_MS + 10000. Un controle
# au demarrage refuse toute valeur plus basse (ADR-13, ADR-14).
GENERATION_STALE_TIMEOUT_MS=150000
